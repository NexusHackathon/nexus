{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "nexus-backend",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "uvicorn",
        "main:app",
        "--reload",
        "--reload-dir",
        "backend",
        "--app-dir",
        "backend",
        "--port",
        "8800"
      ],
      "port": 8800
    },
    {
      "name": "nexus-frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "frontend", "run", "dev"],
      "port": 5173
    }
  ]
}
